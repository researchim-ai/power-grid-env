{
  "schema_version": "power-grid-env.motor-sensitivity/v1",
  "id": "loaded-motor-sag-parameter-screen",
  "design": "one_at_a_time",
  "axes": [
    {"id": "inertia", "parameter": "inertia_s", "equipment_id": "m", "factors": [0.8, 1.0, 1.2]},
    {"id": "rotor", "parameter": "rotor_r_pu", "equipment_id": "m", "factors": [0.8, 1.0, 1.2]},
    {"id": "grid", "parameter": "source_series_impedance", "equipment_id": "source", "factors": [0.8, 1.0, 1.2]}
  ],
  "observations": [
